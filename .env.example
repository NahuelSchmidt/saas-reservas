# Base de datos (Neon / Supabase Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Conexión directa sin pooling, usada por las migraciones de Prisma
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth (Auth.js)
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_WEBHOOK_SECRET=""

# Resend (email transaccional)
RESEND_API_KEY=""
EMAIL_FROM="Sistema Padel <no-reply@sistema-padel.com>"

# Vercel Blob (fotos de canchas / logos)
BLOB_READ_WRITE_TOKEN=""

# URL base de la app (usada para armar links en emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
