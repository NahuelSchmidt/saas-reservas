# Base de datos (Neon / Supabase Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Conexión directa sin pooling, usada por las migraciones de Prisma
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth (Auth.js)
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Número de WhatsApp (solo dígitos, con código de país, ej. "5491122334455")
# al que un dueño de complejo escribe pidiendo su panel — no hay alta manual.
CONTACT_WHATSAPP_NUMBER=""

# Mercado Pago Connect — cada complejo conecta su propia cuenta (ver
# lib/payments/mercadopago-connect.ts) para que las señas le lleguen directo.
# CLIENT_ID/SECRET son de la aplicación de Mercado Pago de la plataforma
# (una sola, se crea una vez en el panel de desarrolladores).
MERCADOPAGO_CLIENT_ID=""
MERCADOPAGO_CLIENT_SECRET=""
MERCADOPAGO_WEBHOOK_SECRET=""
# Clave de 32 bytes en base64 para encriptar los tokens guardados. Generar con:
# openssl rand -base64 32
MERCADOPAGO_TOKEN_ENCRYPTION_KEY=""

# Resend (email transaccional)
RESEND_API_KEY=""
EMAIL_FROM="SportNex <no-reply@sportnex.com>"

# Vercel Blob (fotos de canchas / logos)
BLOB_READ_WRITE_TOKEN=""

# URL base de la app (usada para armar links en emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Evolution API (WhatsApp, self-hosted) — WhatsApp Connect: cada complejo
# vincula su propio número escaneando un QR (ver lib/whatsapp/evolution-connect.ts).
# EVOLUTION_API_KEY es el apikey global del servidor, administra todas las
# instancias (una por complejo) — no hay una "instancia única" como antes.
EVOLUTION_API_URL="https://tu-evolution-api.up.railway.app"
EVOLUTION_API_KEY=""
# Secreto propio (cualquier string largo random) para validar que los webhooks
# de CONNECTION_UPDATE vengan de nuestro servidor de Evolution.
EVOLUTION_WEBHOOK_SECRET=""
